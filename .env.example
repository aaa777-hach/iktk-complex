# Required in prod (--spring.profiles.active=prod)
# Never commit real values.

# --- Database ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=iktk_app
POSTGRES_PASSWORD=<required>

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=iktk
RABBITMQ_PASSWORD=<required>
RABBITMQ_VHOST=/iktk

# --- Security ---
IKTK_JWT_SECRET=<required-min-32-bytes>
IKTK_JWT_ISSUER=iktk

# --- Service URLs ---
IKTK_EQUIPMENT_URL=http://equipment-service:8094
IKTK_INTEGRATION_URL=http://integration:8095

# --- Ports (optional) ---
SERVER_PORT=8080