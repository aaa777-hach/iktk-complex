# ============================================================
# Скопируйте в .env и заполните реальными значениями.
# .env добавлен в .gitignore — в репозиторий НЕ попадает.
# ============================================================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=iktk_app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=iktk

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=iktk
RABBITMQ_PASSWORD=change_me
RABBITMQ_VHOST=/iktk

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- MinIO ---
MINIO_USER=minioadmin
MINIO_PASSWORD=change_me

# --- JWT (одинаковый во всех сервисах!) ---
# Минимум 32 символа.
IKTK_JWT_SECRET=change-me-super-secret-key-for-dev-only-min-32-bytes-long-0123456789
IKTK_JWT_ISSUER=iktk

# --- URI сервисов (для gateway) ---
AUTH_URI=http://localhost:8081
ORCHESTRATOR_URI=http://localhost:8082
EQUIPMENT_URI=http://localhost:8094
BOM_URI=http://localhost:8095
ASSEMBLY_URI=http://localhost:8096
RECOMMENDATION_URI=http://localhost:8097